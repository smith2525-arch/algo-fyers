# ==============================================================================
# Dockerfile.ui — Stateless Streamlit Control Console (Google Cloud Run)
# - Structurally isolated: copies ONLY `frontend/` and `.streamlit/`
# - Zero embedded secrets; backend target comes from runtime `API_BASE_URL`
# - Respects Cloud Run dynamic ${PORT} (defaults to 8080) & SIGTERM via `exec`
# ==============================================================================
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Kolkata \
    PORT=8080 \
    API_TIMEOUT_SECONDS=25.0

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends tzdata curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash uiuser

RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir "streamlit>=1.40.0" "httpx>=0.27.2" "plotly>=5.24.0" "tzdata>=2024.2"

COPY .streamlit ./.streamlit
COPY frontend ./frontend

ENV PYTHONPATH=/app

USER uiuser

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${PORT:-8080}/_stcore/health" || exit 1

CMD ["sh", "-c", "exec streamlit run frontend/app.py --server.address=0.0.0.0 --server.port=${PORT:-8080} --server.headless=true"]
