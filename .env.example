# ==============================================================================
# ALGO TRADING CONTROL CENTER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development only.
# NEVER commit real credentials, hostnames, or .env files to version control.
# All values below are non-functional placeholders.
# ==============================================================================

# --- Application Identity & Runtime ---
APP_NAME="Algo Trading Control Center"
APP_ENV="development"
APP_VERSION="0.1.0"
LOG_LEVEL="INFO"
LOG_JSON="true"

# --- Locked Operational Safety Modes (V1) ---
EXECUTION_MODE="PAPER_ONLY"
EXECUTION_BROKER="INTERNAL_PAPER_BROKER"
MARKET_MODE="HISTORICAL_AND_REPLAY"
TIMEZONE="Asia/Kolkata"

# --- Optional FYERS Historical Market Data (HISTORICAL OHLCV READ-ONLY; NEVER EXECUTION) ---
FYERS_HISTORICAL_DATA_ENABLED="true"
FYERS_CLIENT_ID="<YOUR_FYERS_APP_ID_E_G_XXXXXXXX-100>"
FYERS_SECRET_KEY="<YOUR_FYERS_APP_SECRET_OPTIONAL>"
FYERS_REDIRECT_URI="<YOUR_FYERS_REDIRECT_URI_OPTIONAL>"
FYERS_ACCESS_TOKEN="<YOUR_SHORT_LIVED_FYERS_ACCESS_TOKEN>"
FYERS_HISTORICAL_DATA_URL="https://api-t1.fyers.in/data/history"
FYERS_REQUEST_TIMEOUT_SECONDS=20.0
FYERS_MAX_RETRIES=3
FYERS_RETRY_BACKOFF_SECONDS=0.5
FYERS_MAX_DATE_RANGE_DAYS=365
FYERS_DEFAULT_DATE_RANGE_DAYS=90

# --- Neon Serverless PostgreSQL Connection ---
# Inject real value via Render Secret Environment Variable or Google Secret Manager:
DATABASE_URL="<YOUR_NEON_DATABASE_URL>"
# Pool Mode: NULLPOOL (recommended for Render Free / Cloud Run scale-to-zero with Neon -pooler) | QUEUE
DB_POOL_MODE="NULLPOOL"
DB_SSLMODE="require"
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3
DB_POOL_RECYCLE_SECONDS=180
DB_CONNECT_TIMEOUT_SECONDS=15
# Keep false in deployed cloud web services; run controlled migrations/seeding separately
AUTO_SEED_REFERENCE_DATA="false"

# --- Initial Demonstration Paper Account Reference Config ---
DEFAULT_OPERATOR_USERNAME="desk.operator"
DEFAULT_OPERATOR_DISPLAY_NAME="Primary Desk Operator"
DEFAULT_PAPER_ACCOUNT_CODE="PAPER-DESK-001"
DEFAULT_PAPER_ACCOUNT_NAME="Institutional Demo Paper Book"
DEFAULT_DEMO_CAPITAL_INR="500000.00"

# --- Configurable Instrument Reference Defaults (Seeded once if missing) ---
NIFTY_DEFAULT_LOT_SIZE=75
NIFTY_DEFAULT_TICK_SIZE="0.05"
BANKNIFTY_DEFAULT_LOT_SIZE=30
BANKNIFTY_DEFAULT_TICK_SIZE="0.05"
DEFAULT_EXCHANGE_CODE="NSE"
DEFAULT_SESSION_OPEN_IST="09:15:00"
DEFAULT_SESSION_CLOSE_IST="15:30:00"

# --- Market Replay & Freshness Guardrails (DEMONSTRATION SETTINGS ONLY) ---
MARKET_DATA_STALE_THRESHOLD_SECONDS=10
SIGNAL_EXPIRY_SECONDS=15
REPLAY_BASE_CANDLES_PER_SECOND=1.0
# Keep false on scale-to-zero hosting (Render Free / Cloud Run min-instances=0)
REPLAY_WORKER_ENABLED="false"

# --- Simulated Paper Trading, Risk Engine & Paper Broker DEMO Defaults (PAPER_ONLY) ---
DEMO_MAX_DAILY_LOSS_INR="10000.00"
DEMO_MAX_RISK_PER_TRADE_INR="2500.00"
DEMO_MAX_TRADES_PER_STRATEGY_DAY=5
DEMO_CONSECUTIVE_LOSS_PAUSE=3
DEMO_MAX_GROSS_EXPOSURE_INR="6000000.00"
DEMO_MAX_ORDER_VALUE_INR="3000000.00"
DEMO_MAX_ACCOUNT_TRADES_PER_DAY=15
DEMO_STRATEGY_DAILY_LOSS_INR="6000.00"
DEMO_MAX_STRATEGY_DRAWDOWN_INR="8000.00"
DEMO_COOLDOWN_SECONDS_AFTER_LOSS=300
DEMO_MAX_HOLDING_DURATION_SECONDS=14400
PAPER_FUTURES_MARGIN_RATE="0.12"
PAPER_DEFAULT_LATENCY_MS=120
PAPER_DEFAULT_LATENCY_BARS=1
PAPER_DEFAULT_SLIPPAGE_BPS="2.0"
PAPER_DEFAULT_CHARGES_BPS="1.5"
PAPER_DEFAULT_PER_ORDER_FEE_INR="20.0"
PAPER_MAX_ORDER_QUANTITY=1800
PAPER_MAX_OPEN_POSITIONS=4

# --- FastAPI Backend ---
API_HOST="0.0.0.0"
API_PORT=8080
CORS_ALLOWED_ORIGINS="<YOUR_STREAMLIT_UI_URL>"

# --- Streamlit Control Console ---
API_BASE_URL="<YOUR_FASTAPI_BASE_URL>"
API_TIMEOUT_SECONDS=25.0
UI_PORT=8080
