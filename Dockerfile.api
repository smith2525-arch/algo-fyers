# ==============================================================================
# Dockerfile.api — Stateless FastAPI + Core Trading Services (Google Cloud Run)
# - Zero embedded secrets or database hostnames
# - Respects Cloud Run dynamic ${PORT} (defaults to 8080)
# - Uses `exec` so uvicorn is PID 1 and handles SIGTERM graceful shutdown
# ==============================================================================
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Kolkata \
    PORT=8080 \
    EXECUTION_MODE=PAPER_ONLY \
    TIMEZONE=Asia/Kolkata \
    DB_POOL_MODE=NULLPOOL \
    DB_SSLMODE=require \
    REPLAY_WORKER_ENABLED=false \
    AUTO_SEED_REFERENCE_DATA=false

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends tzdata curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash appuser

# Install ONLY backend runtime dependencies BEFORE copying source code so:
# 1. Heavy UI-only packages (`streamlit`, `pyarrow` 55MB, `pandas`, `numpy`, `plotly`) are excluded from the API image
# 2. Docker layer caching keeps `pip install` cached (0.0s) across `core/` and `backend/` code deploys
RUN pip install --no-cache-dir \
    "fastapi>=0.115.0" \
    "uvicorn[standard]>=0.32.0" \
    "pydantic>=2.9.0" \
    "pydantic-settings>=2.6.0" \
    "sqlalchemy>=2.0.36" \
    "psycopg[binary]>=3.2.3" \
    "alembic>=1.14.0" \
    "httpx>=0.27.2" \
    "tzdata>=2024.2"

COPY pyproject.toml README.md alembic.ini ./
COPY core ./core
COPY backend ./backend
COPY migrations ./migrations
COPY demo_data ./demo_data
COPY deploy ./deploy

ENV PYTHONPATH=/app

USER appuser

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${PORT:-8080}/health/live" || exit 1

CMD ["sh", "-c", "exec uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8080} --timeout-graceful-shutdown 10"]

