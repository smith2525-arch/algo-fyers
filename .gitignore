# ==============================================================================
# ALGO TRADING CONTROL CENTER — GIT IGNORE RULES
# Protects environment files, credentials, private keys, and local test artifacts.
# ==============================================================================

# Environment & Secrets (NEVER commit real .env files; keep .env.example)
.env
.env.*
!.env.example

# Private Keys, Certificates & Cloud Service Account Credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*credentials*.json
*service-account*.json
*secret*.json
*.token
*fyers*token*

# Python Virtual Environments & Bytecode
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/

# Test, Coverage & Type-Check Caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local Ephemeral Databases & Logs (Production uses Neon PostgreSQL only)
*.db
*.sqlite
*.sqlite3
*.log

# OS / Editor Artifacts
.DS_Store
Thumbs.db
.vscode/
.idea/
